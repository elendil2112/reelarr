# Optional — Reelarr runs without this file. Copy to .env to override.

# Host port for the web UI
#REELARR_PORT=8189

# Who owns the files Reelarr writes (unRAID: 99 / 100)
#PUID=1000
#PGID=1000
#UMASK=022
#TZ=America/New_York

# Where Reelarr keeps its settings and databases on the host
#REELARR_CONFIG_DIR=./config

# The host folder holding your music and downloads, and where it appears
# inside the container. The setup wizard picks folders within it.
#REELARR_MEDIA_DIR=/mnt/user
#REELARR_MEDIA_PATH=/mnt/user
